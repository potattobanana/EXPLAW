DATABASE_URL=postgresql://statute_app:statute_app@db:5432/statute_app
SSO_BASE_URL=https://sso.agc.gov.sg
# Comma-separated SSO short Act codes to track (find one via
# https://sso.agc.gov.sg/Browse/Frequently-Accessed-Legislation - the code
# is the last path segment of an Act's URL, e.g. CoA1967 for Companies Act).
TRACKED_ACT_CODES=CoA1967,PDPA2012

# "anthropic" (direct Claude API) or "openai" (any OpenAI-compatible
# gateway, incl. OpenRouter - set AI_BASE_URL for that).
AI_PROVIDER=anthropic
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Singapore Statutes Online MCP connector (sg-eli-mcp,
# https://mcpmarket.com/server/singapore-statutes-online) - `pip install
# sg-eli-mcp` (needs Python 3.11+; it's in requirements.txt already).
# SG_STATUTES_MCP_COMMAND must resolve on PATH, or use "python -m
# sg_eli_mcp" via SG_STATUTES_MCP_ARGS on Windows if Smart App Control
# blocks the console-script exe.
SG_STATUTES_MCP_COMMAND=sg-eli-mcp
SG_STATUTES_MCP_ARGS=

SCRAPE_CRON_HOUR=0
SCRAPE_CRON_MINUTE=0
